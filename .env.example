# Public Google OAuth client ID for the Photos Picker API.
# Create a Web application OAuth client and add http://localhost:5173 as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=

# Optional legacy backend OAuth-code flow. The browser token flow above does not require a client secret.
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/oauth/callback

# Used to encrypt local/backend session cookies.
SESSION_SECRET=
PUBLIC_APP_URL=http://localhost:5173

# Optional default; users can still choose in the UI.
VITE_INKJOY_DEFAULT_SERVER=global
