# Google OAuth client for the Photos Picker API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/oauth/callback

# Used to encrypt local/backend session cookies.
SESSION_SECRET=
PUBLIC_APP_URL=http://localhost:5173

# Optional default; users can still choose in the UI.
VITE_INKJOY_DEFAULT_SERVER=global
